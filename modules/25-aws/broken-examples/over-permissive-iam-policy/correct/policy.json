{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowInvoiceBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::company-order-invoices-prod",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "invoices/*"
          ]
        }
      }
    },
    {
      "Sid": "AllowInvoiceObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::company-order-invoices-prod/invoices/*"
    },
    {
      "Sid": "AllowOrderQueueConsume",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:us-east-1:123456789012:order-fulfillment-prod"
    },
    {
      "Sid": "AllowKMSDecryptOrderPayload",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/b8f9e2d1-4567-4890-a123-abcdef012345",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.us-east-1.amazonaws.com",
          "kms:EncryptionContext:service": "order-fulfillment"
        }
      }
    }
  ]
}
